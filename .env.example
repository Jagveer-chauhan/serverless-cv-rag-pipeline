# Application
PROJECT_NAME="Serverless CV Parsing & RAG Pipeline"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SLA_TARGET_MS=5000.0

# Server
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://cv-rag-frontend.onrender.com"]

# Supabase (PostgreSQL + pgvector)
# Example: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
SUPABASE_DB_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/postgres"
SUPABASE_KEY=""

# Hugging Face Serverless Inference API
HF_API_KEY=""
HF_MODEL_NAME="google/gemma-3-4b-it"

# Embedding Model
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIM=384

# Keepalive Secret (Optional)
KEEPALIVE_SECRET=""
